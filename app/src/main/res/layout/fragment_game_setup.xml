<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/setup_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/setupScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_players"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <!-- Format follows entirely from how many rows are visible below:
                 2 → 1v1, 3 → free-for-all, 4 → 2v2 — nothing to pick by hand. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/formatLabel"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkable="false"
                android:clickable="false"
                android:focusable="false"
                app:chipBackgroundColor="@color/resume_card_fill"
                app:chipStrokeColor="@color/brass"
                app:chipStrokeWidth="1dp"
                tools:text="Free-for-all — every player for themselves" />

            <!-- Seat rows are inflated here: at most four, so no RecyclerView.
                 Fixed views keep focus and IME behaviour predictable. -->
            <LinearLayout
                android:id="@+id/seatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addPlayerButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_add_score"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="18dp"
                android:text="@string/setup_add_player" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="28dp"
                android:enabled="false"
                android:text="@string/setup_start"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
        </LinearLayout>
    </ScrollView>

    <!-- Name suggestions float here, above the form, so the card can be placed by measuring the
         field it belongs to (see SuggestionOverlay). Empty space in it doesn't take touches. -->
    <FrameLayout
        android:id="@+id/suggestionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/suggestionCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <ScrollView
                android:id="@+id/suggestionScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:id="@+id/suggestionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
