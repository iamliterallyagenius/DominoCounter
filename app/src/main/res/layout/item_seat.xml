<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.textfield.TextInputLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/seatLayout"
    style="?attr/textInputOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:endIconContentDescription="@string/setup_remove_player"
    app:endIconDrawable="@drawable/ic_remove_player"
    app:endIconMode="custom"
    app:errorEnabled="true"
    app:startIconDrawable="@drawable/ic_player"
    tools:hint="Team A · Player 1">

    <AutoCompleteTextView
        android:id="@+id/seatInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:completionThreshold="1"
        android:imeOptions="actionNext"
        android:inputType="textPersonName|textCapWords"
        android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>
