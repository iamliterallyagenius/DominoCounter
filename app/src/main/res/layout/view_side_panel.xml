<?xml version="1.0" encoding="utf-8"?>
<!-- One scoring side. Inflated 2 or 3 times into fragment_scoreboard's container. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sideCard"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_weight="1"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp">

        <View
            android:id="@+id/sideStripe"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_side_stripe" />

        <TextView
            android:id="@+id/sideName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="Wael &amp; Bilal" />

        <TextView
            android:id="@+id/sideScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurface"
            tools:text="65"
            tools:textSize="56sp" />

        <TextView
            android:id="@+id/sideToWin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            tools:text="35 to win" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/foulButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            tools:text="+50 Foul" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addScoreButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/score_add"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
